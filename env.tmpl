# Settings for setup-local.sh and build-local.sh.
# Copy this file to .env and fill it in. .env is not committed.

# Directory for the ZMK sources, Zephyr SDK and build output (~3.5 GB). Required.
ZMK_WORKSPACE=

# ZMK tag or branch. Default: the zmk revision from config/west.yml.
#ZMK_REVISION=

# Zephyr SDK version. Default: 0.16.8.
#ZEPHYR_SDK_VER=

# Python interpreter used to create the virtualenv. Default: python3.
#PYTHON=

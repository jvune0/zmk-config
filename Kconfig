# Shared code that temporarily takes the LEDs over from the underglow.
config ZMK_LED_TAKEOVER
    bool

config ZMK_BATTERY_LED_INDICATOR
    bool "Show battery level on the RGB underglow LEDs"
    default y
    depends on ZMK_RGB_UNDERGLOW && ZMK_BATTERY_REPORTING
    select ZMK_LED_TAKEOVER

if ZMK_BATTERY_LED_INDICATOR

config ZMK_BATTERY_LED_DURATION_MS
    int "How long the battery level is shown after &bat_ind is pressed"
    default 3000

config ZMK_BATTERY_LED_BRIGHTNESS
    int "Indicator brightness in percent (0 = follow the underglow brightness)"
    range 0 100
    default 0

config ZMK_BATTERY_LED_LEVEL_HIGH
    int "Battery level above which the indicator is green"
    default 60

config ZMK_BATTERY_LED_LEVEL_LOW
    int "Battery level above which the indicator is yellow (red at or below)"
    default 30

config ZMK_BATTERY_LED_WARN_LEVEL
    int "Blink red when the battery drops to this level (0 disables)"
    range 0 100
    default 15

config ZMK_BATTERY_LED_WARN_STEP
    int "Repeat the low battery warning every N percent of further discharge"
    range 1 100
    default 5

config ZMK_BATTERY_LED_WARN_BLINKS
    int "Number of blinks in the low battery warning"
    default 3

config ZMK_BATTERY_LED_TEST_STEP_MS
    int "&bat_test: time per percent of simulated discharge"
    default 100

endif

config ZMK_LED_STRIP_INDICATORS
    bool "Caps Lock indicator LED on top of the RGB underglow"
    default y
    depends on DT_HAS_ZMK_LED_STRIP_INDICATORS_ENABLED && ZMK_RGB_UNDERGLOW
    select ZMK_HID_INDICATORS

if ZMK_LED_STRIP_INDICATORS

config ZMK_CAPS_LOCK_LED_BRIGHTNESS
    int "Caps Lock LED brightness in percent (0 = follow the underglow brightness)"
    range 0 100
    default 0

endif

config ZMK_LED_SCAN
    bool "&led_scan: light the LEDs one by one to find their order in the chain"
    default y
    depends on DT_HAS_ZMK_BEHAVIOR_LED_SCAN_ENABLED && ZMK_RGB_UNDERGLOW
    select ZMK_LED_TAKEOVER

if ZMK_LED_SCAN

config ZMK_LED_SCAN_DELAY_MS
    int "How long each LED is lit"
    default 500

endif
